# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Generation
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=

# Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Video (optional)
GOOGLE_VIDEO_SERVICE_ACCOUNT_JSON=
PIAPI_API_KEY=

# Research / admin (optional)
# Winning-ad research provider: self-hosted scraper (scraper/run.sh) first, ScrapeCreators fallback, Apify last
AD_SCRAPER_URL=http://127.0.0.1:8787
SCRAPER_TOKEN=
RESEARCH_PROVIDER=
SCRAPECREATORS_API_KEY=
APIFY_API_TOKEN=
APIFY_META_ADS_ACTOR=
# true = test winning-ad research with sample ads instead of Apify
AD_RESEARCH_MOCK=
USAGE_ADMIN_EMAILS=

# Generation models (defaults are the strongest available; override to adopt newer ids)
IMAGE_MODEL=gemini-3-pro-image
# gemini (default when GEMINI_API_KEY is set; needs billing on the AI Studio project) | vertex
# | seedance (default engine for API calls that name no model; in the app the model menu decides)
VIDEO_PROVIDER=gemini
VEO_MODEL=veo-3.1-generate-001
VEO_RESOLUTION=1080p
VEO_GENERATE_AUDIO=true
VEO_LOCATION=us-central1
# ml (default) | off — product cutout engine for pasting real product pixels into ads
PRODUCT_CUTOUT_ENGINE=ml

# Video price in credits = the model's list cost in USD x this rate (length, quality and model all
# count; a draft is a cheap test render). 60 keeps today's 192 credits for an 8 s 1080p Veo clip.
NEXT_PUBLIC_VIDEO_CREDITS_PER_USD=60

# Seedance video (ByteDance, on BytePlus ModelArk). Pick a Seedance model in the app's video model menu.
# See which models your key can use (dev server, generates nothing): http://localhost:3000/api/dev/seedance
ARK_API_KEY=
# Default model when none is picked: dreamina-seedance-2-5-260628 | dreamina-seedance-2-0-260128 |
# dreamina-seedance-2-0-fast-260128 | dreamina-seedance-2-0-mini-260615 | seedance-1-0-pro-250528 | seedance-1-0-pro-fast-251015
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
# Seedance 2.x refuses frames with a real person's face (a store model); those go to this model (none = off).
# A clip with a spoken line goes to Veo instead when Veo is configured, since 1.0 Pro has no sound.
SEEDANCE_FACE_MODEL=seedance-1-0-pro-250528
# 480p | 720p | 1080p (default) | 4k (Seedance 2.0 only); capped to what the model renders
SEEDANCE_RESOLUTION=1080p
# false = silent clips from the 2.x models (1.x never has sound)
SEEDANCE_GENERATE_AUDIO=true
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Claude (Anthropic) writes Playground prompts from the project's references and brief
# ("Write with Claude" in the composer). Get a key at https://platform.claude.com.
ANTHROPIC_API_KEY=
