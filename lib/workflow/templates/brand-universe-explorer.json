      "type": "prompt",
      "position": { "x": 400, "y": 50 },
      "data": {
        "label": "🌃 Cyberpunk Neon",
        "prompt": "Cyberpunk aesthetic, neon lights, futuristic cityscape, holographic elements, purple and cyan color scheme, rain-slicked streets, blade runner vibes, high-tech low-life, glowing signs, dystopian future, digital art style, 4K quality",
        "temperature": 0.85,
        "style": "cyberpunk"
      }
    },
    {
      "id": "cottagecore-prompt",
      "type": "prompt",
      "position": { "x": 400, "y": 170 },
